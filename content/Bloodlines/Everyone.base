views:
  - type: table
    name: Table
    filters:
      or:
        - file.folder == "Bloodlines/Characters"
        - file.folder == "World/NPC"
    order:
      - file.name
      - Race
      - Occupation
      - Residence
      - Age
    sort:
      - property: Race
        direction: ASC
      - property: Age
        direction: ASC
