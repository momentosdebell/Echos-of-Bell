formulas:
  Untitled: |-
    LIST
    FROM "World/NPC"
    WHERE !contains(text, "🔴 Dead")
views:
  - type: table
    name: Table
    filters:
      and:
        - Residence.contains(link("Ambervale"))
        - Age.contains("y/o")
    order:
      - file.name
      - Gender
      - Occupation
      - Race
      - Age
    sort:
      - property: Age
        direction: ASC
